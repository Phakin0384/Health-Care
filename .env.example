# Copy to .env and fill in. .env is git-ignored.
# Every value here has a working default — the app runs with no .env at all.

# Port to listen on. Hosting platforms inject this themselves; leave it unset
# locally to use 3000.
# PORT=3000

# Where the runtime state snapshot is written. Defaults to ./data. Point this
# at a mounted volume if the host's filesystem is ephemeral and you want state
# to survive restarts.
# STATE_DIR=/var/data

# Public base URL of this server. Only needed if something outside the app
# needs to link back to it; the app itself derives URLs from the request.
APP_URL=http://localhost:3000
